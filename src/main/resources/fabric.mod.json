{
	"schemaVersion": 1,
	"id": "calc-commands",
	"version": "${version}",
	"name": "Calc Commands",
	"description": "Client-side calculator commands with expression validation and completion, powered by Symja.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/calc-commands/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
          "io.github.piscescup.fabricmc.CalcCommandsClient"
		],
		"fabric-datagen": [
			"io.github.piscescup.fabricmc.CalcCommandsDataGenerator"
		]
	},
	"mixins": [
		"calc-commands.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
